# Скопируйте в .env без перезаписи существующего файла.
POSTGRES_DB=shorter
POSTGRES_USER=shorter
# Задайте собственный непустой пароль. Это поле намеренно пустое.
# Одинарные кавычки сохраняют буквальные $ и #; пример синтаксиса — в README.
POSTGRES_PASSWORD=
# Публичный адрес nginx; для разработки через Vite используйте http://localhost:5173.
BASE_URL=http://localhost:3000
